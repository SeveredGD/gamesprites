    { "selector": "#pet-overlay > div", "skin": "widowLace", "type": "modal" },
    { "selector": "#floating-gold-readout, #combat-gold-box", "skin": "thornPlaque", "type": "bar" },
    { "selector": "#queue-status-strip", "skin": "chainPlaque", "type": "bar" }
  ]
}
